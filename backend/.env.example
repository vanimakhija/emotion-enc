# ───────────────────────────────────────────────
# SECURITY
# ───────────────────────────────────────────────

# JWT signing secret
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-change-in-production

# AES key derivation master secret
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_SECRET=your-encryption-secret-change-in-production

# JWT expiry in minutes (default 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ───────────────────────────────────────────────
# DATABASE
# ───────────────────────────────────────────────

# SQLite (dev):
DATABASE_URL=sqlite:///./emotion_encryption.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/emotion_enc

# ───────────────────────────────────────────────
# FRONTEND
# ───────────────────────────────────────────────

FRONTEND_URL=http://localhost:3000

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ───────────────────────────────────────────────
# GOOGLE OAUTH
# ───────────────────────────────────────────────

# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ───────────────────────────────────────────────
# FILE ATTACHMENTS
# ───────────────────────────────────────────────

# Local disk path for uploaded attachments
ATTACHMENT_STORAGE_PATH=./uploads

# ───────────────────────────────────────────────
# LOGGING
# ───────────────────────────────────────────────

LOG_LEVEL=INFO
